# OPENAI_API_KEY=
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_db

# LLM_PROVIDER=
# LLM_MODEL=
# EMBEDDING_MODEL=
# REASONING_EFFORT=
# LLM_TIMEOUT=
# MOVIE_COLLECTION=mcu_movies
# ENRICHED_COLLECTION=mcu_movies_enriched

# 웹 검색 (선택, 서비스 경로 전용 · 평가에서는 끔, architecture.md §6)
# BRAVE_API_KEY=
# WEB_COLLECTION=mcu_web
# WEB_STORE=false          # 저장 권한 있는 Brave 요금제에서만 true (웹 컬렉션 + web_search_log 적재)
# WEB_STORE_TTL_DAYS=30    # 검색 기록이 이보다 오래되면 Brave 를 다시 부른다

# 로깅 (선택)
# LOGGING_MODE=info          # debug / info / warning / error
# LOG_FILE=logs/app.log      # 비우면 터미널에만 출력
