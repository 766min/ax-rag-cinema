# 팀 데이터 공간 — 폴더 자리(.gitkeep)만 올리고 안의 데이터는 막는다 (로컬에서 고칠 것 없음)
# 데이터셋은 data/cineverse-dataset-schema/ 에 둔다. IMDb 값이 있어 공개 저장소에 올리지 않는다
data/*
!data/.gitkeep

# 시험 실행 기록 (run_id 끝에 -try 를 붙인 파일, 최종 run 만 커밋)
results/*-try*.jsonl